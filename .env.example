# Copy to .env for local dev. `.env.production` (real values set before deploy)
# is used automatically for `npm run build`.
VITE_API_URL=http://localhost:8080
# the separate platform-admin app (smartschool-admin); only shown to isPlatformAdmin users
VITE_ADMIN_URL=http://localhost:3010
# optional: Google Analytics id; only used by production builds (see src/lib/analytics.ts)
VITE_GA_ID=
# reCAPTCHA v2 site key for the forgot-password page; Google must list this domain for the key
VITE_RECAPTCHA_SITE_KEY=
